# Copy to .env and fill in before `docker compose up` (or `npm start`).
# .env itself is gitignored — never commit real values.

# Classify and log without acting (deleting/warning/blocking). Starts on;
# review results before setting to 0 and trusting it against a real contact.
SHADOW_MODE=1

# Set to 1 only to test the pipeline against messages you send yourself
# (no second WhatsApp number needed) — see README "Testing each layer in
# isolation".
TEST_ALLOW_SELF=0

# --- Classifier (src/classifier/classifier.js) ---
# Docker Compose and a local Ollama both use this loopback address.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
CLASSIFIER_TIMEOUT_MS=90000
# Number of prior messages included as conversation context. Default: 10.
CLASSIFIER_HISTORY_LIMIT=10

# --- Warning message generation (src/classifier/warning-message.ts) ---
# The reply sent to a contact after a flagged message is generated per
# violation (naming the actual reason and warning them an automated system
# will block them), not a fixed string. Defaults to OLLAMA_MODEL/OLLAMA_HOST
# above; override independently only if you want a different model/host for
# generation than for classification.
#WARNING_MODEL=llama3.2:3b
#WARNING_TIMEOUT_MS=90000
# 0 = deterministic, higher = more varied phrasing. Default: 0.4.
#WARNING_TEMPERATURE=0.4
# Hard cap on the generated message's length, in characters. Default: 320.
#WARNING_MAX_LENGTH=320

# --- Strike / block / unblock (src/pipeline/, src/buffer/) ---
# Strikes before a block is triggered. Default: 3.
STRIKE_THRESHOLD=3
# Block length in ms before auto-unblock is scheduled. Default: 24h.
BLOCK_DURATION_MS=86400000
# +/- randomization applied to BLOCK_DURATION_MS. Default: 4h.
BLOCK_JITTER_MS=14400000
# How often the unblock scheduler checks for expired blocks. Default: 2min.
UNBLOCK_POLL_INTERVAL_MS=120000
# Debounce window messages are buffered for before classification. Default: 7s.
BUFFER_WINDOW_MS=7000

# --- Store (src/store/db.js) ---
# Path is relative to the container's WORKDIR (/app) when run via Docker —
# the default already matches the data/ volume mount in docker-compose.yml.
DB_PATH=data/moderation.sqlite

# Fallback text sent to a contact only if the LLM-generated warning above
# fails open (Ollama unreachable, timeout, empty response). Default shown below.
WARNING_MESSAGE=That message was removed for violating this chat's policy.

# --- Web control app (src/web/, issues #29, #32) ---
# Unset (default) disables the control server entirely — and with it, the
# only way to add a contact to the monitored-contacts roster, since there is
# no TARGET_CONTACT_JID equivalent anymore (see docs/decisions.md
# "Multi-contact moderation roster"). Only reachable through `tailscale
# serve` proxying to 127.0.0.1:<this port> — see README "Web control app"
# and docs/decisions.md before enabling this.
#WEB_CONTROL_PORT=4756
# The one Tailscale login (as Tailscale reports it, e.g. you@github,
# you@gmail.com) allowed to use the control app, checked against the
# Tailscale-User-Login header `tailscale serve` sets — no shared secret.
# Required if WEB_CONTROL_PORT is set, the process refuses to start
# otherwise. Trusting this header assumes you're the only account with
# shell access to this host — see docs/decisions.md if that's not true.
#ALLOWED_TAILSCALE_LOGIN=you@example.com
