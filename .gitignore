node_modules/
.DS_Store

# Built frontend bundle (content-hashed filenames; control-server.js reads
# this directory at startup, rebuilt via `npm run build:web`/`watch:web`).
web/dist/

# Claude Code local state — settings.json is shared/committed (see below), everything else stays local
.claude/*
!.claude/settings.json

# WhatsApp linked-device session (Signal protocol keys) — equivalent to a
# credential, never commit this.
auth_info/
auth_info*/

# Local state / audit DB (strikes, block records, audit log — see
# src/store/). WAL mode also produces -wal/-shm sidecar files.
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
.env

# Opt-in local override to build from source instead of pulling the
# published image — see docker-compose.override.yml.example (the template,
# stays tracked) and README "Building from source". Exact name, not a
# broader glob, so a real docker-compose*.yml a contributor adds on purpose
# isn't swallowed by accident.
docker-compose.override.yml
