node_modules
.DS_Store

# Built frontend bundle (content-hashed filenames; control-server.js reads
# this directory at startup, rebuilt via `npm run build:web`/`watch:web`).
web/dist/
web/dist-demo/

# Claude Code local state — settings.json is shared/committed (see below), everything else stays local
.claude/*
!.claude/settings.json

# WhatsApp linked-device session (Signal protocol keys) — equivalent to a
# credential, never commit this.
auth_info/
auth_info*/

# Local state / audit DB (strikes, block records, audit log — see
# src/store/). WAL mode also produces -wal/-shm sidecar files.
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
.env

# The moderation policy now lives in SQLite (src/store/settings.ts), not this
# file — but an operator upgrading from an older release may still have a
# real config/policy.md on disk with a real, possibly personal policy in it.
# Keep it gitignored defensively even though the app no longer reads it.
config/policy.md

# Opt-in local override to build from source instead of pulling the
# published image — see compose.override.yml.example (the template,
# stays tracked) and README "Building from source". Exact name, not a
# broader glob, so a real compose*.yml a contributor adds on purpose isn't
# swallowed by accident.
compose.override.yml

# Local conversation scenarios built from real chats — they describe real people, so they stay off GitHub
src/simulation/scenarios/*.local.json
