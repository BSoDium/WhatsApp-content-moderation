# Opt-in for contributors/development only. Copy this to
# docker-compose.override.yml (gitignored, Compose auto-merges it when
# present — no -f flag needed) to build the app from your local source
# instead of pulling the published ghcr.io image:
#
#   cp docker-compose.override.yml.example docker-compose.override.yml
#   docker compose up -d --build
#
# A distinct image tag (whatsapp-content-moderation:dev, not the ghcr.io
# name) keeps your local build from ever being confused with, or silently
# overwriting, a pulled release image.
services:
  app:
    build: .
    image: whatsapp-content-moderation:dev
